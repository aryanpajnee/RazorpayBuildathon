# Razorpay test mode. Dashboard > Settings > API Keys > Generate Test Key.
# Test keys always start with rzp_test_. Never commit a live key.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Set after creating the webhook in the Razorpay dashboard (needs a public
# tunnel URL first — see Phase 3).
RAZORPAY_WEBHOOK_SECRET=

# LLM provider for the agent surfaces: "gemini", "anthropic" or "openai".
# Gemini is the default because its free tier does tool-calling and needs no
# card. Free tier limits: 15 req/min, 1500 req/day.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Only needed if you switch LLM_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
