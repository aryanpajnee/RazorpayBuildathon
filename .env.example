# Razorpay test mode. Dashboard > Settings > API Keys > Generate Test Key.
# Test keys always start with rzp_test_. Never commit a live key.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Set after creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# LLM provider for the buyer agent: "anthropic" or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
